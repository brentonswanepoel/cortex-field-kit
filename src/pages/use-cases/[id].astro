---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttackList from '../../components/AttackList.astro';
import ExampleBadge from '../../components/ExampleBadge.astro';
import RelatedList from '../../components/RelatedList.astro';
import ReuseSteps from '../../components/ReuseSteps.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCatalogue, getRelated } from '../../lib/catalogue';
import { formatDate, productLabel, statusLabel } from '../../lib/format';

export async function getStaticPaths() {
  const { usecases } = await getCatalogue();
  return usecases.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = await getRelated(entry);
const data = entry.data;
---

<BaseLayout title={data.title} description={data.description}>
  <article class="wrap">
    <header class="page-head">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href={import.meta.env.BASE_URL}>Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`${import.meta.env.BASE_URL}use-cases/`}>Use cases</a></li>
          <li aria-hidden="true">/</li>
          <li>{data.title}</li>
        </ol>
      </nav>
      <p class="eyebrow">Use case</p>
      <h1 class="detail-title">{data.title}</h1>
      <p class="meta-line">
        <ExampleBadge example={data.example} />
        <StatusBadge status={data.status} />
      </p>
      <p>{data.description}</p>
      <dl class="meta-grid">
        <div>
          <dt>Status</dt>
          <dd>{statusLabel(data.status)}</dd>
        </div>
        <div>
          <dt>Products</dt>
          <dd>{data.products.map((product) => productLabel(product)).join(', ')}</dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd><time datetime={data.published.toISOString()}>{formatDate(data.published)}</time></dd>
        </div>
        <div>
          <dt>Updated</dt>
          <dd><time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></dd>
        </div>
      </dl>
      {
        data.attack.length > 0 && (
          <div>
            <h2 class="kicker">ATT&CK</h2>
            <AttackList ids={data.attack} />
          </div>
        )
      }
    </header>
    <section class="callout" aria-labelledby="problem-heading">
      <h2 id="problem-heading">Problem</h2>
      <p>{data.problem}</p>
    </section>
    <section aria-labelledby="data-heading">
      <h2 id="data-heading">Data sources</h2>
      <ul class="plain-list">
        {data.dataSources.map((source) => <li>{source}</li>)}
      </ul>
    </section>
    <section aria-labelledby="success-heading">
      <h2 id="success-heading">Success criteria</h2>
      <ul class="plain-list">
        {data.successCriteria.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <div class="prose">
      <Content />
    </div>
    <ReuseSteps steps={data.reuse} />
    <RelatedList items={related} />
  </article>
</BaseLayout>
