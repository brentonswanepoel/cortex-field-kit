---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttackList from '../../components/AttackList.astro';
import ExampleBadge from '../../components/ExampleBadge.astro';
import RelatedList from '../../components/RelatedList.astro';
import { getCatalogue, getRelated } from '../../lib/catalogue';
import { formatDate, productLabel } from '../../lib/format';

export async function getStaticPaths() {
  const { snippets } = await getCatalogue();
  return snippets.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = await getRelated(entry);
const data = entry.data;
---

<BaseLayout title={data.title} description={data.description}>
  <article class="wrap">
    <header class="page-head">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href={import.meta.env.BASE_URL}>Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`${import.meta.env.BASE_URL}snippets/`}>Snippets</a></li>
          <li aria-hidden="true">/</li>
          <li>{data.title}</li>
        </ol>
      </nav>
      <p class="eyebrow">Snippet · {data.language}</p>
      <h1 class="detail-title">{data.title}</h1>
      <p class="meta-line">
        <ExampleBadge example={data.example} />
      </p>
      <p>{data.description}</p>
      <dl class="meta-grid">
        <div>
          <dt>Products</dt>
          <dd>{data.products.map((product) => productLabel(product)).join(', ')}</dd>
        </div>
        <div>
          <dt>Language</dt>
          <dd>{data.language}</dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd><time datetime={data.published.toISOString()}>{formatDate(data.published)}</time></dd>
        </div>
        <div>
          <dt>Updated</dt>
          <dd><time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></dd>
        </div>
      </dl>
      <div>
        <h2 class="kicker">ATT&CK</h2>
        <AttackList ids={data.attack} />
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <RelatedList items={related} />
  </article>
</BaseLayout>
