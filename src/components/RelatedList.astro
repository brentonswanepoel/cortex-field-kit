---
import { collectionLabels, entryHref } from '../lib/format';
import type { CatalogueItem } from '../lib/format';

interface Props {
  items: CatalogueItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="related-heading">
      <h2 id="related-heading">Related</h2>
      <ul class="related-list">
        {items.map((item) => (
          <li>
            <a href={entryHref(item.collection, item.entry.id)}>
              <span class="update-kind">{collectionLabels[item.collection]}</span>
              <strong>{item.entry.data.title}</strong>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
